{
  "name": "youtube-download",
  "version": "1.0.0",
  "description": "Windows 桌面端图形化 YouTube 下载器（Electron + Vue3 + yt-dlp + ffmpeg），支持中英文硬字幕烧录",
  "author": "Winking",
  "license": "MIT",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev": "vite build && electron .",
    "build": "vite build",
    "dist": "cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://cdn.npmmirror.com/binaries/ vite build && electron-builder --win nsis",
    "dist:portable": "cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://cdn.npmmirror.com/binaries/ vite build && electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^5.4.0",
    "vue": "^3.4.0"
  }
}
